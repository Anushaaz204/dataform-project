config {
    type: "assertion",
    schema: "gold"
}

  /*
  * This code ensures the following data quality checks
  * "Ensure no duplicates for 'month' and 'traffic_source_medium'."
  */
SELECT
  COUNT(*) AS duplicate_check,
  month,
  traffic_source_medium
FROM
  ${ref("top_traffic_source_medium")}
GROUP BY
  month,
  traffic_source_medium
HAVING
  duplicate_check > 1
